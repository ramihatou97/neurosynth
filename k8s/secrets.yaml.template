# Template for secrets - DO NOT commit with real values
# Copy to secrets.yaml and fill in base64-encoded values
#
# To encode: echo -n 'your-api-key' | base64
# To apply: kubectl apply -f k8s/secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: neurosynth-secrets
  namespace: neurosynth
  labels:
    app.kubernetes.io/name: neurosynth
type: Opaque
data:
  # Base64-encoded API keys
  ANTHROPIC_API_KEY: <base64-encoded-key>
  GOOGLE_API_KEY: <base64-encoded-key>
  VOYAGE_API_KEY: <base64-encoded-key>
