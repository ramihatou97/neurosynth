# =============================================================================
# NeuroSynth Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: API Keys
# -----------------------------------------------------------------------------

# Anthropic Claude API (for synthesis and AI operations)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API (for extraction and structure analysis)
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=...

# Voyage AI API (for embeddings and semantic search)
# Get your key at: https://dash.voyageai.com/
VOYAGE_API_KEY=pa-...

# -----------------------------------------------------------------------------
# OPTIONAL: Model Configuration
# -----------------------------------------------------------------------------

# Override default models (uncomment to use)
# GEMINI_MODEL=gemini-2.0-flash-exp
# CLAUDE_MODEL=claude-sonnet-4-20250514
# VOYAGE_MODEL=voyage-large-2-instruct

# -----------------------------------------------------------------------------
# OPTIONAL: Processing Configuration
# -----------------------------------------------------------------------------

# Chunk size for document processing (default: 1500)
# CHUNK_SIZE=1500

# Overlap between chunks (default: 200)
# CHUNK_OVERLAP=200

# Number of chunks to retrieve per query (default: 50)
# RETRIEVAL_TOP_K=50

# Minimum similarity score for retrieval (default: 0.7)
# SIMILARITY_THRESHOLD=0.7

# Similarity threshold for deduplication (default: 0.85)
# DEDUP_THRESHOLD=0.85

# Maximum images per section (default: 5)
# MAX_IMAGES_PER_SECTION=5

# -----------------------------------------------------------------------------
# OPTIONAL: Path Configuration
# -----------------------------------------------------------------------------

# Path to PDF library (default: data/library)
# LIBRARY_PATH=data/library

# Path for processed content (default: data/processed)
# PROCESSED_PATH=data/processed

# Path for generated output (default: data/output)
# OUTPUT_PATH=data/output

# SQLite database path (default: data/index.db)
# DATABASE_PATH=data/index.db

# Qdrant local storage path (default: data/qdrant)
# QDRANT_PATH=data/qdrant

# -----------------------------------------------------------------------------
# OPTIONAL: Vector Store (Qdrant)
# -----------------------------------------------------------------------------

# Enable pushing text chunks to Qdrant (default: true)
# ENABLE_QDRANT_PUSH=true

# Enable pushing images to Qdrant (default: true)
# ENABLE_IMAGE_QDRANT_PUSH=true

# Qdrant server URL (default: http://localhost:6333)
# QDRANT_URL=http://localhost:6333

# Text chunks collection name (default: neurosynth_chunks)
# QDRANT_COLLECTION_NAME=neurosynth_chunks

# Image collection name (default: neurosurgical_figures_hybrid)
# IMAGE_QDRANT_COLLECTION=neurosurgical_figures_hybrid

# -----------------------------------------------------------------------------
# OPTIONAL: Batch Processing
# -----------------------------------------------------------------------------

# Maximum PDFs to process concurrently (default: 3)
# MAX_CONCURRENT_PDFS=3

# Text embedding batch size (default: 128)
# EMBEDDING_BATCH_SIZE=128

# Image embedding batch size (default: 32)
# IMAGE_EMBEDDING_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# OPTIONAL: Logging
# -----------------------------------------------------------------------------

# Log level: debug, info, warning, error (default: info)
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# DOCKER/PRODUCTION ONLY
# -----------------------------------------------------------------------------

# Redis URL for job queue (only needed for Docker deployment)
# REDIS_URL=redis://localhost:6379

# Number of worker replicas (only for Docker deployment)
# WORKER_REPLICAS=1

# -----------------------------------------------------------------------------
# STUDY SUITE: Template Parameters (exposed in UI)
# -----------------------------------------------------------------------------
# These are set via UI controls, but can be defaulted here

# Oral Examiner defaults
# EXAMINER_DEFAULT_DIFFICULTY=standard
# EXAMINER_DEFAULT_CASE_TYPE=clinical

# MCQ Generator defaults
# MCQ_DEFAULT_DIFFICULTY=application
# MCQ_DEFAULT_STYLE=clinical_vignette

# Audio Briefing defaults
# AUDIO_DEFAULT_DURATION=2min
# AUDIO_DEFAULT_FORMAT=morning_rounds
