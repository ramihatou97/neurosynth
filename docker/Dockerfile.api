# NeuroSynth API Service
# Thin FastAPI layer for job submission and status queries
# Stateless - all state stored in Redis

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

# Build arguments for image traceability
ARG BUILD_DATE
ARG GIT_SHA
ARG VERSION

# OCI Image Labels
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.title="neurosynth-api"
LABEL org.opencontainers.image.description="NeuroSynth API Service"
LABEL org.opencontainers.image.source="https://github.com/ramihatoum/neurosynth"

# Prevent Python from writing pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set working directory
WORKDIR /app

# Install system dependencies (minimal for API)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# Copy dependency files
COPY pyproject.toml ./

# Install API dependencies only
RUN pip install --no-cache-dir \
    "fastapi>=0.109.0" \
    "uvicorn[standard]>=0.27.0" \
    "redis>=5.0.0" \
    "python-multipart>=0.0.6" \
    "pydantic>=2.5.0" \
    "pydantic-settings>=2.1.0" \
    "python-dotenv>=1.0.0"

# Copy application code
COPY src/neurosynth/api ./src/neurosynth/api
COPY src/neurosynth/__init__.py ./src/neurosynth/

# Create non-root user
RUN groupadd -r neurosynth --gid=1000 && \
    useradd -r -g neurosynth --uid=1000 --home-dir=/home/neurosynth --shell=/bin/bash neurosynth && \
    mkdir -p /home/neurosynth && \
    chown -R neurosynth:neurosynth /home/neurosynth /app

# Create data directory for job files
RUN mkdir -p /data/jobs && chown -R neurosynth:neurosynth /data

# Switch to non-root user
USER neurosynth

# Set Python path
ENV PYTHONPATH=/app/src

# Expose API port
EXPOSE 8000

# Health check - curl the /health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run uvicorn
ENTRYPOINT ["python", "-m", "uvicorn"]
CMD ["neurosynth.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
